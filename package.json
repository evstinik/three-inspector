{
  "name": "three-inspector",
  "version": "0.1.1",
  "description": "A Three.js scene inspector for React Three Fiber applications",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "repository": {
    "url": "https://github.com/evstinik/three-inspector"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "pnpm -C example dev",
    "test": "vitest",
    "lint": "eslint src --ext ts,tsx",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src tests example/src"
  },
  "peerDependencies": {
    "@react-three/fiber": "^8.0.0 || ^9.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "three": "^0.164.0"
  },
  "devDependencies": {
    "@react-three/fiber": "^8.0.0",
    "@react-three/test-renderer": "^8.0.0",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@types/three": "^0.164.0",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-react": "^7.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^6.2.4",
    "vitest": "^3.1.1"
  },
  "keywords": [
    "three.js",
    "react-three-fiber",
    "inspector",
    "debug",
    "development"
  ],
  "author": "Nikita Evstigneev",
  "license": "MIT",
  "dependencies": {
    "@mantine/hooks": "^7.17.4",
    "@tabler/icons-react": "^3.31.0",
    "react-arborist": "^3.4.3",
    "zustand": "^5.0.3"
  }
}
